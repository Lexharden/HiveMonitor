{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiveMonitor",
  "version": "0.1.0",
  "identifier": "com.yafeldev.hivemonitor",
  "build": {
    "beforeDevCommand": "bun --filter @hivemonitor/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun --filter @hivemonitor/web build",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "HiveMonitor",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: http: ws:; object-src 'none'; base-uri 'self'; frame-src https://player.twitch.tv; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
