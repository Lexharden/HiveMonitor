{
  "name": "hive-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*", "scripts"],
  "scripts": {
    "dev:web": "bun --filter @hivemonitor/web dev",
    "dev:api": "bun --filter @hivemonitor/api dev",
    "dev:desktop": "bun --filter @hivemonitor/desktop tauri dev",
    "build:web": "bun --filter @hivemonitor/web build",
    "check": "bun --filter '*' check",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
